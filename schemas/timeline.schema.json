{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CINEMA HOLIC timeline",
  "type": "object",
  "required": ["episode", "fps", "size", "background", "bgm", "shots"],
  "properties": {
    "episode": { "type": "string", "pattern": "^ep[0-9]{2}" },
    "fps": { "const": 30 },
    "size": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
    "background": { "type": "string", "description": "assets/backgrounds/ 内のファイル" },
    "poster": { "type": "string", "description": "assets/posters/ 内のファイル（壁のフレームに入る）" },
    "props": { "type": "array", "items": { "type": "string" } },
    "bgm": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": { "type": "string" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.45 }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "duration"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["brand_intro", "text", "room", "closeup", "prescription", "end_card"] },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "pause_before": { "type": "number", "minimum": 0 },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "speaker", "text"],
              "properties": {
                "id": { "type": "string" },
                "speaker": { "enum": ["gonbe", "johndoe", "narration"] },
                "text": { "type": "string" },
                "expression": { "type": "string" },
                "highlight": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "text": {
            "type": "array",
            "description": "type=text のときに順に表示する行",
            "items": {
              "type": "object",
              "required": ["value"],
              "properties": {
                "value": { "type": "string" },
                "at": { "type": "number" },
                "highlight": { "type": "array", "items": { "type": "string" } },
                "size": { "enum": ["normal", "large"] }
              }
            }
          },
          "focus": { "enum": ["gonbe", "johndoe", "both"] },
          "camera": {
            "type": "object",
            "properties": {
              "zoom_from": { "type": "number" },
              "zoom_to": { "type": "number" },
              "ease": { "enum": ["linear", "inOut"] }
            }
          },
          "sfx": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "at"],
              "properties": { "file": { "type": "string" }, "at": { "type": "number" } }
            }
          },
          "prescription": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "year": { "type": "integer" },
              "dosage": { "type": "string" },
              "side_effect": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
