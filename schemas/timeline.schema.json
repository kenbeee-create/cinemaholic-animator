{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CINEMA HOLIC timeline",
  "type": "object",
  "required": [
    "episode",
    "fps",
    "size",
    "background",
    "bgm",
    "shots"
  ],
  "properties": {
    "episode": {
      "type": "string",
      "pattern": "^ep[0-9]{2}"
    },
    "fps": {
      "const": 30
    },
    "size": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "background": {
      "type": "string",
      "description": "assets/backgrounds/ 内のファイル"
    },
    "poster": {
      "type": "string",
      "description": "assets/posters/ 内のファイル（壁のフレームに入る）"
    },
    "props": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bgm": {
      "type": "object",
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.45
        },
        "ducking_db": {
          "type": "number",
          "default": -10
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "duration"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "brand_intro",
              "text",
              "room",
              "closeup",
              "extreme",
              "prescription",
              "end_card"
            ]
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "pause_before": {
            "type": "number",
            "minimum": 0
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "speaker",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "speaker": {
                  "enum": [
                    "gonbe",
                    "johndoe",
                    "narration"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "expression": {
                  "type": "string"
                },
                "highlight": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "pose": {
                  "type": "string"
                },
                "reaction": {
                  "enum": [
                    "nod",
                    "tilt",
                    "stare",
                    "none"
                  ],
                  "description": "聞き役の反応"
                },
                "caption_style": {
                  "enum": [
                    "default",
                    "emphasis",
                    "whisper"
                  ]
                },
                "emphasis": {
                  "type": "boolean"
                }
              }
            }
          },
          "text": {
            "type": "array",
            "description": "type=text のときに順に表示する行",
            "items": {
              "type": "object",
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": "string"
                },
                "at": {
                  "type": "number"
                },
                "highlight": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "size": {
                  "enum": [
                    "normal",
                    "large"
                  ]
                }
              }
            }
          },
          "focus": {
            "enum": [
              "gonbe",
              "johndoe",
              "both"
            ]
          },
          "camera": {
            "type": "object",
            "properties": {
              "zoom_from": {
                "type": "number"
              },
              "zoom_to": {
                "type": "number"
              },
              "ease": {
                "enum": [
                  "linear",
                  "inOut"
                ]
              }
            }
          },
          "sfx": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "file",
                "at"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "at": {
                  "type": "number"
                }
              }
            }
          },
          "prescription": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "year": {
                "type": "integer"
              },
              "dosage": {
                "type": "string"
              },
              "side_effect": {
                "type": "string"
              }
            }
          },
          "fx": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "preset",
                "at"
              ],
              "properties": {
                "preset": {
                  "type": "string",
                  "description": "renderer/presets の名前（例 fx.sweat）"
                },
                "at": {
                  "type": "number"
                },
                "target": {
                  "enum": [
                    "gonbe",
                    "johndoe",
                    "screen"
                  ]
                },
                "duration": {
                  "type": "number"
                }
              }
            }
          },
          "sfx_cue": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "at",
                "hint"
              ],
              "properties": {
                "at": {
                  "type": "number"
                },
                "hint": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}